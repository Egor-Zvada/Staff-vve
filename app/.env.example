# Copy to .env.local on the server; replace placeholders before use.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
DATABASE_URL='mysql://staffv2:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:3306/staff_v2?charset=utf8mb4'

# Optional external Wallet module. Empty disables new issuance.
WALLETWALLET_API_KEY=

# Optional independent service configuration; empty values keep it disabled.
BACKDOOR_LOGIN=
BACKDOOR_PASSWORD_HASH=
PRIVATE_PATH=
