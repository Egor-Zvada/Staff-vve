{% extends 'admin/base.html.twig' %}
{% block title %}Отпуска · Staff{% endblock %}
{% block page_title %}Отпуска сотрудников{% endblock %}
{% block content %}
{% set canEdit = user.admin_role|default('') == 'ADMIN' %}
<div class="page-heading"><div><span class="eyebrow">Кадровый календарь</span><h1>Отпуска</h1><p class="muted">Период включает первый и последний день. Можно оформить уже прошедший отпуск.</p></div><a class="button ghost" href="/admin/help#leaves">Справка</a></div>
<form method="get" class="card toolbar"><label>Сотрудник<select name="employee_id"><option value="">Все сотрудники</option>{% for e in employees %}<option value="{{ e.id }}" {{ filter_employee_id == e.id ? 'selected' : '' }}>{{ e.name }} · {{ e.display_id }}{{ not e.active ? ' · уволен' : '' }}</option>{% endfor %}</select></label><label>Записи<select name="state"><option value="active" {{ filter_state == 'active' ? 'selected' : '' }}>Назначенные</option><option value="revoked" {{ filter_state == 'revoked' ? 'selected' : '' }}>Отменённые</option><option value="all" {{ filter_state == 'all' ? 'selected' : '' }}>Все</option></select></label><button class="button" type="submit">Показать</button></form>
{% if canEdit %}
<form action="/admin/leaves/save" method="post" class="card" data-ajax style="margin-top:22px">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="id" value="{{ edit.id|default('') }}"><input type="hidden" name="version" value="{{ edit.version|default('') }}">
<div class="section-heading"><div><span class="eyebrow">{{ edit ? 'Период #' ~ edit.id : 'Новый период' }}</span><h2>{{ edit ? 'Изменить отпуск' : 'Назначить отпуск' }}</h2></div>{% if edit %}<a class="button ghost" href="/admin/leaves?employee_id={{ edit.employee_id }}">Новый отпуск</a>{% endif %}</div>
{% if edit and not edit.active %}<p class="notice">Этот отпуск отменён. Для повторного назначения создайте новый период.</p>{% endif %}
<div class="form-grid"><label class="span-all">Сотрудник{% if edit %}<input type="hidden" name="employee_id" value="{{ edit.employee_id }}"><select disabled>{% for e in employees %}<option {{ edit.employee_id == e.id ? 'selected' : '' }}>{{ e.name }} · {{ e.display_id }}</option>{% endfor %}</select>{% else %}<select name="employee_id" required><option value="">Выберите сотрудника</option>{% for e in employees %}<option value="{{ e.id }}" {{ filter_employee_id == e.id ? 'selected' : '' }}>{{ e.name }} · {{ e.display_id }}{{ not e.active ? ' · уволен' : '' }}</option>{% endfor %}</select>{% endif %}</label><label>С даты<input type="date" name="start_date" value="{{ edit.start_date|default('') }}" required></label><label>По дату включительно<input type="date" name="end_date" value="{{ edit.end_date|default('') }}" required></label><label class="span-all">Примечание или номер приказа · необязательно<input name="note" value="{{ edit.note|default('') }}" maxlength="1000" placeholder="Например, приказ № 15"></label></div>
<p class="small muted" style="margin-top:18px">Дни отпуска освобождаются от нарушений, в том числе при оформлении задним числом. Исходные отметки и история сохраняются. Отмена или сокращение периода возвращает обычную проверку соответствующих дней.</p>
<div class="form-footer"><button class="button primary" type="submit" {{ edit and not edit.active ? 'disabled' : '' }}>Сохранить отпуск</button></div></form>
{% endif %}
<section class="card table-card" style="margin-top:22px"><div class="section-heading"><h2>Периоды отпусков</h2><span class="muted small">{{ leaves|length }} записей</span></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Сотрудник</th><th>Период</th><th>Статус</th><th>Примечание</th><th>Внесено</th>{% if canEdit %}<th>Действия</th>{% endif %}</tr></thead><tbody>{% for l in leaves %}<tr><td><strong>{{ l.employee_name }}</strong><br><span class="small muted">{{ l.display_id }}{{ not l.employee_active ? ' · уволен' : '' }}</span></td><td>{{ l.start_date|date('d.m.Y') }} — {{ l.end_date|date('d.m.Y') }}</td><td><span class="tag {{ l.active ? 'success' : '' }}">{{ not l.active ? 'Отменён' : l.end_date < 'now'|date('Y-m-d','Asia/Sakhalin') ? 'Прошедший' : l.start_date > 'now'|date('Y-m-d','Asia/Sakhalin') ? 'Предстоящий' : 'В отпуске' }}</span></td><td>{{ l.note ?: '—' }}</td><td>{{ (l.updated_at ~ ' UTC')|date('d.m.Y H:i','Asia/Sakhalin') }}<br><span class="small muted">{{ l.actor_name }}</span></td>{% if canEdit %}<td>{% if l.active %}<div class="button-row"><a class="button small ghost" href="/admin/leaves?employee_id={{ l.employee_id }}&amp;state={{ filter_state }}&amp;edit={{ l.id }}">Изменить</a><form action="/admin/leaves/revoke" method="post" data-ajax data-confirm="Отменить отпуск? В эти дни снова будут проверяться нарушения."><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="id" value="{{ l.id }}"><input type="hidden" name="version" value="{{ l.version }}"><button class="button small" type="submit">Отменить</button></form></div>{% else %}—{% endif %}</td>{% endif %}</tr>{% else %}<tr><td colspan="{{ canEdit ? 6 : 5 }}" class="empty">По выбранному фильтру отпусков нет.</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
