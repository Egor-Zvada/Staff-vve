{% extends 'admin/base.html.twig' %}{% block title %}Импорт · Staff{% endblock %}{% block page_title %}Импорт сотрудников{% endblock %}
{% block content %}<div class="page-heading"><div><span class="eyebrow">Проверка перед записью</span><h1>Импорт сотрудников</h1><p class="muted">Сначала сверка файла, затем подтверждённая партия</p></div><a class="button ghost" href="/admin/help#import">Формат файла</a></div>
<form class="card" method="post" action="/admin/import/preview" enctype="multipart/form-data"><input name="csrf" type="hidden" value="{{ csrf }}"><div class="grid-even"><div class="drop-zone"><h3>CSV или Excel</h3><p class="small muted">ID, фамилия, имя, отчество, должность и статус. Старые ID сохраняются.</p><input type="file" name="file" accept=".csv,.xlsx,.xls" required></div><div><h3>Режим импорта</h3><label>Существующие ID<select name="mode"><option value="add_only">Добавлять новые, существующие пропускать</option><option value="merge">Добавлять и обновлять существующих</option></select></label><p class="small muted" style="margin-top:15px">Роли и пароли файлом не назначаются. Повторная партия не создаёт дубли.</p><button class="button primary" type="submit">Проверить файл</button></div></div></form>
{% if preview|default(null) %}<section class="card" style="margin-top:22px"><div class="section-heading"><div><span class="eyebrow">Предварительный просмотр</span><h2>{{ preview.file_name|default('Файл') }}</h2></div><span class="tag">{{ preview.mode == 'merge' ? 'Обновление разрешено' : 'Только новые' }}</span></div><div class="import-summary">{% for label,count in {'Новые':preview.summary.create|default(0),'Обновить':preview.summary.update|default(0),'Пропустить':preview.summary.skip|default(0),'Ошибки':preview.summary.errors|default(0)} %}<span class="tag {{ loop.last and count ? 'error' : '' }}">{{ label }}: {{ count }}</span>{% endfor %}</div><div class="table-scroll"><table class="data-table"><thead><tr><th>Строка</th><th>Действие</th><th>ID</th><th>ФИО</th><th>Изменения / ошибки</th></tr></thead><tbody>{% for r in preview.rows|default([]) %}<tr><td>{{ r.row }}</td><td><span class="tag {{ r.action == 'error' ? 'error' : '' }}">{{ r.action }}</span></td><td>{{ r.display_id|default('Назначится автоматически') }}</td><td>{{ r.data.surname|default('') }} {{ r.data.given_name|default('') }} {{ r.data.patronymic|default('') }}</td><td>{% for field,diff in r.diff|default({}) %}<div class="small">{{ field }}: <span class="diff-value old">{{ diff.before }}</span> → <span class="diff-value new">{{ diff.after }}</span></div>{% endfor %}{% for error in r.errors|default([]) %}<div class="small" style="color:var(--red)">{{ error }}</div>{% endfor %}</td></tr>{% endfor %}</tbody></table></div><form action="/admin/import/commit" method="post" class="form-footer" data-confirm="Применить проверенную партию сотрудников?"><input name="csrf" type="hidden" value="{{ csrf }}"><input name="token" type="hidden" value="{{ preview.token }}"><p class="small muted">{{ preview.summary.errors|default(0) ? 'Исправьте ошибки в файле: партия не записывается частично.' : 'После применения изменения попадут в историю административных действий.' }}</p><button class="button primary" {{ preview.summary.errors|default(0) ? 'disabled' : '' }}>Применить импорт</button></form></section>{% endif %}
{% if summary|default(null) and not preview|default(null) %}<div class="notice success" style="margin-top:20px">Импорт завершён: добавлено {{ summary.created|default(0) }}, обновлено {{ summary.updated|default(0) }}, пропущено {{ summary.skipped|default(0) }}.</div>{% endif %}{% endblock %}
