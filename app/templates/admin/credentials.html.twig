{% extends 'admin/base.html.twig' %}{% block title %}NFC-карты · Staff{% endblock %}{% block page_title %}NFC-карты{% endblock %}
{% block content %}<div class="page-heading"><div><span class="eyebrow">Носители</span><h1>NFC-карты сотрудников</h1><p class="muted">Карта связана с постоянным ID; отзыв NFC не меняет QR</p></div><a class="button ghost" href="/admin/help#nfc">Инструкция</a></div>
<form class="card" action="/admin/credentials/save" method="post" data-ajax><input name="csrf" type="hidden" value="{{ csrf }}"><div class="section-heading"><h2>Привязать карту</h2></div><div class="form-grid three"><label>Сотрудник<select name="employee_id" required>{% for e in employees|default([]) %}<option value="{{ e.id }}">{{ e.name|default(e.full_name|default('Сотрудник')) }} · {{ e.display_id|default(e.pass_code|default('%03d'|format(e.id))) }}</option>{% endfor %}</select></label><label>Тип<select name="kind"><option value="nfc">NFC</option></select></label><label>UID карты<input name="value" required autocomplete="off" placeholder="UID настроенного считывателя"></label></div><div class="form-footer"><span class="small muted">Существующая чужая привязка выдаст конфликт, а не перенесётся молча.</span><button class="button primary">Привязать</button></div></form>
<section class="card table-card" style="margin-top:22px"><div class="section-heading"><h2>Реестр карт</h2></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Сотрудник</th><th>Тип</th><th>UID</th><th>Состояние</th><th></th></tr></thead><tbody>{% for c in credentials|default(rows|default([])) %}<tr><td class="person"><strong>{{ c.name|default(c.full_name|default('ID ' ~ c.employee_id)) }}</strong><span>ID {{ c.display_id|default(c.pass_code|default('%03d'|format(c.employee_id))) }}</span></td><td>{{ c.kind|upper }}</td><td><code class="code">{{ c.value }}</code></td><td><span class="tag {{ c.active ? 'success' : '' }}">{{ c.active ? 'Активна' : 'Отозвана' }}</span></td><td>{% if c.active %}<form action="/admin/credentials/revoke" method="post" data-confirm="Отозвать карту? QR и ID сотрудника сохранятся."><input name="csrf" type="hidden" value="{{ csrf }}"><input name="id" type="hidden" value="{{ c.id }}"><button class="button small danger">Отозвать</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="empty">NFC-карты ещё не зарегистрированы</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
