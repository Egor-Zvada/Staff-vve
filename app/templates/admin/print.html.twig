{% extends 'admin/base.html.twig' %}{% block title %}Пропуска и печать · Staff{% endblock %}{% block page_title %}Пропуска и печать{% endblock %}
{% block head %}<script src="/assets/print.js" defer></script>{% endblock %}
{% block content %}<div class="page-heading"><div><span class="eyebrow">Локальный QR · единый макет</span><h1>Редактор пропусков</h1><p class="muted">Выберите людей, оформите карточки и расположите на листе</p></div><div class="button-row"><button class="button" id="download-png">PNG / ZIP</button><button class="button" id="print-badges">Печать</button><button class="button primary" id="download-pdf">↓ PDF</button></div></div>
<div class="print-editor" id="print-editor">
<aside class="card print-panel"><h3>Сотрудники</h3><label>Выбор<select id="print-mode"><option value="selected">Выбранные</option><option value="one">Один</option><option value="range">Диапазон номеров записей</option><option value="all">Все из списка</option><option value="group">По группе графика</option></select></label><label id="print-one-wrap" hidden>Сотрудник<select id="print-one">{% for e in employees|default([]) %}<option value="{{ e.id }}">{{ e.name|default(e.full_name|default('Сотрудник')) }} · {{ e.display_id|default(e.pass_code|default('%03d'|format(e.id))) }}</option>{% endfor %}</select></label><div class="form-grid" id="print-range-wrap" hidden><label>От № записи<input id="print-from" type="number" min="1"></label><label>До № записи<input id="print-to" type="number" min="1"></label></div><label id="print-group-wrap" hidden>Группа<select id="print-group"><option value="">Выберите группу</option>{% for g in groups|default([]) %}<option value="{{ g.id }}">{{ g.name }}</option>{% endfor %}</select></label><label class="check"><input type="checkbox" id="print-active" checked> Только работающие</label><input id="print-search" type="search" placeholder="Поиск ФИО / ID" aria-label="Поиск для выдачи"><div class="employee-picker" id="print-employees"></div><div class="inline"><button class="text-button" id="print-select-visible">Выбрать видимых</button><button class="text-button" id="print-clear">Сбросить</button></div><p class="small muted" id="print-selection-count"></p><p class="small muted">До 200 карточек в одной партии. Большой список разделите на партии; карточки не исключаются молча.</p>
<details open><summary>Шаблон карточки</summary><label>Сохранённый шаблон<select id="badge-template"><option value="">Текущий</option>{% for t in templates|default([]) %}<option value="{{ t.id }}">{{ t.name }}</option>{% endfor %}</select></label><label>Название для сохранения<input id="badge-template-name" placeholder="Например, основной пропуск"></label><button class="button small" id="save-template" {{ user.admin_role|default('') != 'ADMIN' ? 'disabled' : '' }}>Сохранить шаблон</button></details>
<details open><summary>Текст и оформление</summary><label>Организация<input data-template="org_name" value="{{ settings.org_name|default('СШ ВВЕ') }}"></label><label>Подпись<input data-template="org_sub" value="Спортивная школа"></label><label>ФИО<select data-template="name_mode"><option value="full">Полностью</option><option value="initials">Фамилия и инициалы</option></select></label><div class="form-grid"><label>Ширина, мм<input data-template="width_mm" type="number" min="35" max="150" step="0.01" value="53.98"></label><label>Высота, мм<input data-template="height_mm" type="number" min="35" max="150" step="0.01" value="85.6"></label></div><button class="button small" id="badge-orientation">Повернуть шаблон</button><div class="form-grid" style="margin-top:12px"><label>QR, мм<input data-template="qr_mm" type="number" min="16" max="40" value="28"></label><label>Логотип, мм<input data-template="logo_mm" type="number" min="6" max="24" value="12"></label><label>Отступ, мм<input data-template="padding_mm" type="number" min="2" max="10" step="0.5" value="4"></label><label>Шрифт, pt<input data-template="font_size" type="number" min="7" max="16" value="10"></label></div><label>Фон<input data-template="bg_color" type="color" value="#ffffff"></label><label>Фоновая картинка<input id="badge-bg-file" type="file" accept="image/png,image/jpeg,image/webp"></label><button class="text-button" id="badge-bg-clear">Удалить фон-картинку</button><div class="form-grid">{% for key,label in {org:'Организация',sub:'Описание',name:'ФИО',position:'Должность',id:'ID'} %}<label>{{ label }}<input data-template="colors.{{ key }}" type="color" value="{{ key == 'id' ? '#64748b' : '#204a91' }}"></label>{% endfor %}</div><label class="check"><input type="checkbox" data-template="header.on"> Плашка заголовка</label><div class="form-grid"><label>Цвет<input data-template="header.color" type="color" value="#ffffff"></label><label>Непрозрачность<input data-template="header.opacity" type="number" min="0" max="1" step="0.05" value="0.8"></label><label>Радиус, мм<input data-template="header.radius" type="number" min="0" max="10" value="3"></label></div></details>
</aside>
<section class="print-workspace"><div class="print-workspace-toolbar"><div class="button-row"><button class="chip-button" id="print-undo" title="Отменить">↶</button><button class="chip-button" id="print-redo" title="Повторить">↷</button><button class="chip-button" id="print-reflow">Разложить</button></div><label class="inline small">Масштаб<select id="print-zoom"><option value="0.4">40%</option><option value="0.55" selected>55%</option><option value="0.75">75%</option><option value="1">100%</option></select></label></div><div id="print-pages"><div class="print-empty">Выберите сотрудников для пропусков</div></div><p id="print-message" class="form-status" role="status"></p></section>
<aside class="card print-panel">{% if user.admin_role|default('') == 'ADMIN' %}<div class="wallet-print-controls"><h3>Стороны пропуска</h3><label>Печатать<select id="print-output"><option value="front">Лицевая · ID и QR</option><option value="wallet_back">Обратная · QR установки Wallet</option><option value="duplex">Обе · для двусторонней печати</option></select></label><label id="duplex-flip-wrap" hidden>Переворот листа<select id="duplex-flip"><option value="long">По длинной стороне</option><option value="short">По короткой стороне</option></select></label><p class="small muted" id="wallet-print-quota"></p><p class="small muted" id="wallet-print-count"></p><button type="button" class="button small" id="wallet-print-prepare">Подготовить Wallet выбранным</button><button type="button" class="text-button" id="wallet-print-refresh">Проверить статус</button><p id="wallet-print-status" class="form-status" role="status"></p><p class="small muted">Новый пропуск выпускается только по этой кнопке. Обратные страницы зеркально совмещаются с лицевыми; проверьте переворот на одном листе при масштабе 100%.</p></div>{% endif %}<div><h3>Лист печати</h3><label>Пресет<select id="sheet-preset"><option value="">Текущий</option>{% for p in presets|default([]) %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}</select></label><label>Бумага<select id="sheet-format"><option value="A4">A4 · 210 × 297 мм</option><option value="A3">A3 · 297 × 420 мм</option><option value="custom">Пользовательская</option></select></label><label>Ориентация<select id="sheet-orientation"><option value="portrait">Книжная</option><option value="landscape">Альбомная</option></select></label><div class="form-grid"><label>Ширина, мм<input data-sheet="width_mm" type="number" value="210" min="50" max="1000"></label><label>Высота, мм<input data-sheet="height_mm" type="number" value="297" min="50" max="1000"></label></div><label>Раскладка<select id="sheet-mode"><option value="grid">Сетка карточек</option><option value="labels">Лист этикеток</option></select></label><div class="form-grid">{% for key,label in {left:'Слева',right:'Справа',top:'Сверху',bottom:'Снизу'} %}<label>{{ label }}, мм<input data-sheet="margins.{{ key }}" type="number" step="0.1" min="0" max="100" value="10"></label>{% endfor %}<label>Зазор X, мм<input data-sheet="gap_x" type="number" min="0" value="4" step="0.1"></label><label>Зазор Y, мм<input data-sheet="gap_y" type="number" min="0" value="4" step="0.1"></label><label>Сдвиг X, мм<input data-sheet="offset_x" type="number" value="0" step="0.1"></label><label>Сдвиг Y, мм<input data-sheet="offset_y" type="number" value="0" step="0.1"></label></div><label class="check"><input type="checkbox" data-sheet="crop_marks" checked> Метки реза</label><label class="check"><input type="checkbox" id="print-snap"> Привязка к сетке 1 мм</label><details><summary>Этикетки</summary><div class="form-grid"><label>Ячейка X, мм<input data-sheet="labels.cell_width" type="number" value="60" step="0.1"></label><label>Ячейка Y, мм<input data-sheet="labels.cell_height" type="number" value="90" step="0.1"></label><label>Первый X, мм<input data-sheet="labels.start_x" type="number" value="10" step="0.1"></label><label>Первый Y, мм<input data-sheet="labels.start_y" type="number" value="10" step="0.1"></label><label>Шаг X, мм<input data-sheet="labels.step_x" type="number" value="64" step="0.1"></label><label>Шаг Y, мм<input data-sheet="labels.step_y" type="number" value="94" step="0.1"></label><label>Колонки<input data-sheet="labels.columns" type="number" value="3" min="1" max="20"></label><label>Строки<input data-sheet="labels.rows" type="number" value="3" min="1" max="20"></label></div><label>Занятые ячейки первого листа<input id="labels-skip" placeholder="1, 2, 5"></label></details></div>
<div><h3>Выбранная карточка</h3><p class="small muted" id="placement-name">Нажмите карточку на листе</p><div class="form-grid"><label>X, мм<input id="placement-x" type="number" step="0.01"></label><label>Y, мм<input id="placement-y" type="number" step="0.01"></label><label>Страница<input id="placement-page" type="number" min="1" max="50" value="1"></label><label>Поворот<select id="placement-rotation"><option value="0">0°</option><option value="90">90°</option></select></label></div><p class="print-errors" id="print-errors"></p></div>
<div><h3>Сохранение и проверка</h3><label>Название раскладки<input id="sheet-name" placeholder="Принтер · бумага"></label><button class="button small" id="save-sheet" {{ user.admin_role|default('') != 'ADMIN' ? 'disabled' : '' }}>Сохранить пресет</button><p class="small muted" style="margin-top:15px">Координаты задаются от верхнего левого угла листа. Проверьте бумагу, поля драйвера и масштаб 100%.</p><button class="button small" id="print-calibration">Калибровочный лист</button></div></aside>
</div>
<script type="application/json" id="print-config">{{ {employees:employees|default([]),ids:selected_ids|default(ids|default([])),templates:templates|default([]),presets:presets|default([]),org_name:settings.org_name|default('СШ ВВЕ'),template:template|default({}),sheet:sheet|default({})}|json_encode(15)|raw }}</script>
{% endblock %}
