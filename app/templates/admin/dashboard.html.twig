{% extends 'admin/base.html.twig' %}
{% block title %}Обзор · Staff{% endblock %}{% block page_title %}Обзор{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">Рабочий день</span><h1>Сегодня в школе</h1><p class="muted">{{ date|default('') }} · присутствие по зарегистрированным отметкам</p></div><form method="get" class="inline"><input type="date" name="date" value="{{ date|default('') }}" aria-label="Дата обзора"><button class="button" type="submit">Показать</button></form></div>
<div class="metric-grid">{% for label,value in {'Отметились':summary.arrivals|default(0),'На работе по отметкам':summary.present|default(present|default([])|length),'Нет прихода':summary.missing|default(missing|default([])|length),'Замечания':flags|default([])|length} %}<section class="metric-card {{ loop.last ? 'alert' : '' }}"><span class="metric-label">{{ label }}</span><strong>{{ value is iterable ? value|length : value }}</strong><span class="metric-note">{{ loop.index == 2 ? 'Без зарегистрированного ухода' : 'По выбранному рабочему дню' }}</span></section>{% endfor %}</div>
<section class="card" style="margin-bottom:22px"><div class="section-heading"><div><span class="eyebrow">Последние 14 дней</span><h2>Приходы и пунктуальность</h2></div><div class="flag-list"><span class="tag">Вовремя</span><span class="tag error">Опоздание</span><span class="tag warning">Нет прихода</span></div></div><div id="attendance-trend" style="width:100%;min-height:200px"></div><p class="small muted">Только ожидаемые рабочие дни. Выходные без рабочего плана не участвуют.</p></section><script type="application/json" id="trend-data">{{ chart|default([])|json_encode(15)|raw }}</script>
<div class="grid-two"><section class="card table-card"><div class="section-heading"><h2>Отметки за день</h2><a href="/admin/attendance?from={{ date|default('') }}&to={{ date|default('') }}" class="text-button">Полный табель →</a></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Сотрудник</th><th>Приход</th><th>Уход</th><th>Состояние</th></tr></thead><tbody>{% for r in rows|default([])|slice(0,12) %}<tr><td class="person"><strong>{{ r.name|default(r.full_name|default('')) }}</strong><span>{{ r.group_name|default(r.position|default('')) }}</span></td><td class="numeric">{{ r.values.arrival|default(r.arrival|default('—')) }}</td><td class="numeric">{{ r.values.departure|default(r.departure|default('—')) }}</td><td><span class="tag {{ r.flags|default([])|length ? 'warning' : 'success' }}">{{ r.flags|default([])|length ? 'Нужна проверка' : r.status|default('По отметкам') }}</span></td></tr>{% else %}<tr><td colspan="4" class="empty">Отметок за этот день пока нет</td></tr>{% endfor %}</tbody></table></div></section><div class="stack"><section class="card"><span class="eyebrow">Контроль</span><h2>Нужна проверка</h2>{% for r in flags|default([])|slice(0,6) %}<div class="section-heading" style="margin:14px 0"><div><strong>{{ r.name|default(r.full_name|default('ID ' ~ r.employee_id|default(''))) }}</strong><div class="small muted">{{ r.label|default(r.kind|default('Замечание по отметке')) }}</div></div><a class="button small" href="/admin/attendance?from={{ date|default('') }}&to={{ date|default('') }}&employee_id={{ r.employee_id|default(r.id|default('')) }}">Открыть</a></div>{% else %}<p class="muted">По текущим данным замечаний нет.</p>{% endfor %}</section><section class="card"><span class="eyebrow">Важно</span><h3>Присутствие по отметкам</h3><p class="small muted">Приход без ухода означает «на работе по отметкам». Пропущенное сканирование не доказывает физическое присутствие или отсутствие.</p><a href="/admin/help#attendance" class="text-button">Как читать табель →</a></section></div></div>
{% endblock %}
