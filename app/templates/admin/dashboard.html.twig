{% extends 'admin/base.html.twig' %}
{% block title %}Обзор · Staff{% endblock %}{% block page_title %}Обзор{% endblock %}
{% block content %}
{% set finding_labels = {'LATE_ARRIVAL':'Опоздание','EARLY_DEPARTURE':'Ранний уход','MISSING_ARRIVAL':'Нет прихода','MISSING_DEPARTURE':'Нет ухода','NO_MARKS':'Нет отметок','PRIOR_DAY_CHANGE':'Изменение за прошлую дату','CORRECTION':'Изменение времени','EARLIER_TIME_CLAIM':'Внесено позже','INCOMPLETE_BREAK':'Неполный обед','INVALID_ORDER':'Порядок времён'} %}
<div class="page-heading"><div><span class="eyebrow">Рабочий день</span><h1>Обзор дня</h1><p class="muted">{{ date|date('d.m.Y') }} · присутствие по зарегистрированным отметкам</p></div><form method="get" class="inline"><input type="date" name="date" value="{{ date }}" aria-label="Дата обзора"><button class="button" type="submit">Показать</button></form></div>
<div class="metric-grid">{% for label,value in {'Отметились':summary.arrivals|default(0),'На работе по отметкам':summary.present|default(present|default([])|length),'Нет прихода':summary.missing|default(missing|default([])|length),'Замечания':flags|default([])|length} %}<section class="metric-card {{ loop.last ? 'alert' : '' }}"><span class="metric-label">{{ label }}</span><strong>{{ value is iterable ? value|length : value }}</strong><span class="metric-note">{{ loop.index == 2 ? 'По рабочему плану, без отметки ухода' : (loop.index == 1 ? 'По рабочему плану выбранного дня' : 'По выбранному рабочему дню') }}</span></section>{% endfor %}</div>
<section class="card dashboard-trend-card">
  <div class="section-heading"><div><span class="eyebrow">{{ chart_from|date('d.m.Y') }} — {{ date|date('d.m.Y') }}</span><h2>Приходы и пунктуальность</h2></div><div class="flag-list dashboard-legend"><span class="tag"><i class="chart-dot on-time"></i>Вовремя</span><span class="tag error"><i class="chart-dot late"></i>Опоздание</span><span class="tag warning"><i class="chart-dot missing"></i>Нет прихода</span></div></div>
  <p class="small muted dashboard-chart-hint">Нажмите на часть столбца: ниже появится список сотрудников за этот день.</p>
  <div id="attendance-trend" class="dashboard-trend"></div>
  <p class="small muted dashboard-chart-note">Только дни с рабочим планом. Отпуска, охранники и выходные без рабочего плана не участвуют. «Нет прихода» появляется после контрольного времени; отсутствие ухода сюда не относится.</p>
  <div id="dashboard-cohort" class="dashboard-cohort">
    <div class="dashboard-cohort-header"><div><span class="eyebrow" id="dashboard-cohort-source">Приходы и пунктуальность · выбранный день</span><h3 id="dashboard-cohort-title">Выберите столбец</h3></div><span class="tag" id="dashboard-cohort-count">0</span></div>
    <div class="dashboard-cohort-controls" id="dashboard-cohort-controls"><label>День<select id="dashboard-cohort-date" aria-label="День списка сотрудников"></select></label><label>Показать<select id="dashboard-cohort-kind" aria-label="Категория списка сотрудников"><option value="on_time">Пришли вовремя</option><option value="late">Опоздали</option><option value="missing">Нет прихода</option></select></label></div>
    <div class="notice" id="dashboard-cohort-context" hidden><p class="small" id="dashboard-cohort-context-text"></p><button type="button" class="button small" id="dashboard-cohort-return">Вернуться к выбору дня</button></div>
    <div id="dashboard-cohort-body" aria-live="polite"><p class="muted">Нажмите на часть столбца или выберите день и категорию.</p></div>
    <a id="dashboard-cohort-report" class="text-button" href="/admin/attendance?from={{ date }}&to={{ date }}">Открыть день в табеле →</a>
  </div>
</section>
<div class="grid-even dashboard-extra-charts">
  <section class="card"><div class="section-heading"><div><span class="eyebrow">Тот же период</span><h2>Опоздания по группам</h2></div></div><p class="small muted">Доля опозданий среди приходов. Нажмите на группу, чтобы увидеть сотрудников и дни.</p><div id="dashboard-group-chart"></div></section>
  <section class="card"><div class="section-heading"><div><span class="eyebrow">{{ date|date('d.m.Y') }}</span><h2>Во сколько приходят</h2></div></div><p class="small muted">Приходы по сахалинскому времени. Нажмите на час, чтобы увидеть сотрудников.</p><div id="dashboard-hour-chart"></div></section>
</div>
<script type="application/json" id="trend-data">{{ chart|default([])|json_encode(15)|raw }}</script>
<script type="application/json" id="group-chart-data">{{ group_chart|default([])|json_encode(15)|raw }}</script>
<script type="application/json" id="hour-chart-data">{{ hour_chart|default([])|json_encode(15)|raw }}</script>
<script src="/assets/dashboard.js?v={{ asset_version }}" defer></script>
<div class="grid-two"><section class="card table-card"><div class="section-heading"><h2>Отметки за день</h2><a href="/admin/attendance?from={{ date }}&to={{ date }}" class="text-button">Полный табель →</a></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Сотрудник</th><th>Приход</th><th>Уход</th><th>Состояние</th></tr></thead><tbody>{% for r in rows|default([])|slice(0,12) %}<tr><td class="person"><strong>{{ r.name|default(r.full_name|default('')) }}</strong><span>{{ r.group_name|default(r.position|default('')) }}</span></td><td class="numeric">{{ r.values.arrival|default(r.arrival|default('—')) }}</td><td class="numeric">{{ r.values.departure|default(r.departure|default('—')) }}</td><td><span class="tag {{ r.flags|default([])|length ? 'warning' : 'success' }}">{{ r.flags|default([])|length ? 'Нужна проверка' : r.status_label|default('Состояние не определено') }}</span></td></tr>{% else %}<tr><td colspan="4" class="empty">Отметок за этот день пока нет</td></tr>{% endfor %}</tbody></table></div></section><div class="stack"><section class="card"><span class="eyebrow">Контроль</span><h2>Нужна проверка</h2>{% for r in flags|default([])|slice(0,6) %}<div class="section-heading" style="margin:14px 0"><div><strong>{{ r.name|default(r.full_name|default('ID ' ~ r.employee_id|default(''))) }}</strong><div class="small muted">{{ r.label|default(finding_labels[r.kind|default('')]|default('Замечание по отметке')) }}</div></div><a class="button small" href="/admin/attendance?from={{ date }}&to={{ date }}&employee_id={{ r.employee_id|default(r.id|default('')) }}">Открыть</a></div>{% else %}<p class="muted">По текущим данным замечаний нет.</p>{% endfor %}</section><section class="card"><span class="eyebrow">Важно</span><h3>Присутствие по отметкам</h3><p class="small muted">Приход без ухода означает «на работе по отметкам». Пропущенное сканирование не доказывает физическое присутствие или отсутствие.</p><a href="/admin/help#attendance" class="text-button">Как читать табель →</a></section></div></div>
{% endblock %}
