{% extends 'admin/base.html.twig' %}{% block title %}Графики · Staff{% endblock %}{% block page_title %}Графики и календарь{% endblock %}
{% block content %}{% set canEdit = user.admin_role|default('') == 'ADMIN' %}<div class="page-heading"><div><span class="eyebrow">План рабочего дня</span><h1>Графики и календарь</h1><p class="muted">Назначения с датой действия, персональные исключения</p></div><a class="button ghost" href="/admin/help#schedules">Справка</a></div>
<section class="card table-card"><div class="section-heading"><h2>Группы графиков</h2></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Название</th><th>Начало</th><th>Окончание</th><th>Дни недели</th><th>Допуск приход / уход</th></tr></thead><tbody>{% for g in groups|default([]) %}<tr><td>{{ g.name }}</td><td>{{ g.start_time|slice(0,5) }}</td><td>{{ g.end_time|slice(0,5) }}</td><td>{{ g.weekdays is iterable ? g.weekdays|join(', ') : g.weekdays }}</td><td>{{ g.late_grace_seconds|default(0) }} / {{ g.early_grace_seconds|default(0) }} с</td></tr>{% else %}<tr><td colspan="5" class="empty">Групп пока нет</td></tr>{% endfor %}</tbody></table></div></section>
{% if canEdit %}<div class="grid-even" style="margin-top:22px"><form action="/admin/schedules/save" method="post" class="card" data-ajax><input type="hidden" name="csrf" value="{{ csrf }}"><span class="eyebrow">Шаблон</span><h2>Создать или изменить график</h2><div class="form-grid"><label>Существующая группа<select name="id" data-group-editor><option value="">Новая группа</option>{% for g in groups|default([]) %}<option value="{{ g.id }}" data-group="{{ g|json_encode(15) }}">{{ g.name }}</option>{% endfor %}</select></label><label>Название<input name="name" required></label><label>Действует с<input name="valid_from" type="date" value="{{ 'now'|date('Y-m-d','Asia/Sakhalin') }}" required></label><label>Начало<input name="start_time" type="time" value="09:00" required></label><label>Окончание<input name="end_time" type="time" value="18:00" required></label><label>Допуск опоздания, с<input name="late_grace_seconds" type="number" min="0" value="0"></label><label>Допуск раннего ухода, с<input name="early_grace_seconds" type="number" min="0" value="0"></label></div><div class="radio-row" style="margin-top:18px;flex-wrap:wrap">{% for n,label in {1:'Пн',2:'Вт',3:'Ср',4:'Чт',5:'Пт',6:'Сб',7:'Вс'} %}<label class="check"><input type="checkbox" name="weekdays[]" value="{{ n }}" {{ n<6 ? 'checked' : '' }}>{{ label }}</label>{% endfor %}</div><div class="form-footer"><button class="button primary">Сохранить график</button></div></form>
<form id="assignment-form" action="/admin/schedules/assign" method="post" class="card" data-ajax><input type="hidden" name="csrf" value="{{ csrf }}"><input name="id" type="hidden"><span class="eyebrow">Назначение</span><h2>График сотрудника</h2><div class="stack"><label>Сотрудник<select name="employee_id" required>{% for e in employees|default([]) %}<option value="{{ e.id }}">{{ e.name|default(e.full_name|default('Сотрудник')) }} · {{ e.display_id|default(e.pass_code|default('%03d'|format(e.id))) }}</option>{% endfor %}</select></label><label>Группа<select name="group_id" required>{% for g in groups|default([]) %}<option value="{{ g.id }}">{{ g.name }}</option>{% endfor %}</select></label><div class="form-grid"><label>С даты<input type="date" name="valid_from" required></label><label>По дату<input type="date" name="valid_to"></label></div></div><p class="small muted" style="margin-top:18px">Прошлые планы не меняются молча. Новое назначение имеет свой период действия.</p><div class="form-footer"><button class="button primary">Назначить</button></div></form></div>
<form id="calendar-form" action="/admin/schedules/calendar" method="post" class="card" style="margin-top:22px" data-ajax><input type="hidden" name="csrf" value="{{ csrf }}"><div class="section-heading"><div><input name="id" type="hidden"><span class="eyebrow">Календарь</span><h2>Исключение дня</h2></div></div><div class="form-grid three"><label>Сотрудник<select name="employee_id"><option value="">Все сотрудники</option>{% for e in employees|default([]) %}<option value="{{ e.id }}">{{ e.name|default(e.full_name|default('Сотрудник')) }} · {{ e.display_id|default(e.pass_code|default('%03d'|format(e.id))) }}</option>{% endfor %}</select></label><label>Группа<select name="group_id"><option value="">Все группы</option>{% for g in groups|default([]) %}<option value="{{ g.id }}">{{ g.name }}</option>{% endfor %}</select></label><label>Дата<input type="date" name="work_date" required></label><label>День<select name="is_working"><option value="0">Не рабочий</option><option value="1">Рабочий</option></select></label><label>Начало (необязательно)<input type="time" name="start_time"></label><label>Окончание (необязательно)<input type="time" name="end_time"></label><label class="span-all">Причина<input name="reason" required placeholder="Отпуск, рабочий выходной, изменение времени…"></label></div><div class="form-footer"><button class="button primary">Сохранить исключение</button></div></form>{% endif %}
<section class="card table-card" style="margin-top:22px"><div class="section-heading"><h2>Календарные исключения</h2></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Дата</th><th>Сотрудник / группа</th><th>Рабочий</th><th>Причина</th></tr></thead><tbody>{% for e in exceptions|default([]) %}<tr><td>{{ e.work_date }}</td><td>{{ e.employee_name|default(e.group_name|default('Все')) }}</td><td>{{ e.is_working ? 'Да' : 'Нет' }}</td><td>{{ e.reason }}{% if canEdit %} <button class="button small ghost" data-edit-exception="{{ e|json_encode(15) }}">Изменить</button>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="empty">Исключений нет</td></tr>{% endfor %}</tbody></table></div></section><section class="card table-card" style="margin-top:22px"><div class="section-heading"><h2>Назначения сотрудников</h2></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Сотрудник</th><th>Группа</th><th>С</th><th>По</th><th></th></tr></thead><tbody>{% for a in assignments|default([]) %}<tr><td>{{ a.employee_name|default('ID ' ~ a.employee_id) }}</td><td>{{ a.group_name }}</td><td>{{ a.valid_from }}</td><td>{{ a.valid_to|default('Без окончания') }}</td><td>{% if canEdit %}<button class="button small" data-edit-assignment="{{ a|json_encode(15) }}">Изменить</button>{% endif %}</td></tr>{% else %}<tr><td colspan="5" class="empty">Назначений пока нет</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
