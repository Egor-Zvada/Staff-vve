{% extends 'admin/base.html.twig' %}
{% block title %}Состояние · Staff{% endblock %}
{% block page_title %}Состояние системы{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">Эксплуатация</span><h1>Состояние системы</h1><p class="muted">Время сервера, доступность базы и последние резервные копии</p></div><a href="/admin/status" class="button">Обновить</a></div>
{% set names = {php_version:'Версия PHP',database_version:'Версия MariaDB',timezone:'Часовой пояс',server_time:'Время сервера',employees:'Сотрудников в реестре',disk_free_bytes:'Свободно на диске',last_backup_at:'Последняя успешная копия',local_backup_ok:'Локальная копия',external_copy_ok:'Внешняя копия',external_copy_configured:'Внешнее резервирование настроено'} %}
<section class="card"><div class="status-grid">
{% for key,value in status|default(summary|default({})) %}
<dl class="status-item"><dt>{{ names[key]|default(key) }}</dt><dd>
{% if value is same as(null) %}<span class="muted">Не определено</span>
{% elseif key == 'disk_free_bytes' %}{{ (value / 1073741824)|number_format(1,',',' ') }} GiB
{% elseif value is same as(true) %}<span class="tag success">Да</span>
{% elseif value is same as(false) %}<span class="tag warning">Нет</span>
{% else %}{{ value is iterable ? value|json_encode : value }}{% endif %}
</dd></dl>
{% else %}<div class="empty">Сведения пока недоступны</div>{% endfor %}
</div></section>
<div class="notice" style="margin-top:22px">Путь резервирования сам по себе не подтверждает готовую копию. Проверяйте время успешного задания и результат восстановления.</div>
{% endblock %}
