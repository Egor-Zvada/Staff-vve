{% extends 'admin/base.html.twig' %}{% block title %}Сотрудники · Staff{% endblock %}{% block page_title %}Сотрудники{% endblock %}
{% block content %}{% set canEdit = user.admin_role|default('') == 'ADMIN' %}
<div class="page-heading"><div><span class="eyebrow">Кадровый справочник</span><h1>Сотрудники</h1><p class="muted">Постоянные ID, графики и административный доступ</p></div>{% if canEdit %}<button class="button primary" data-employee-new>+ Добавить сотрудника</button>{% endif %}</div>
<section class="card table-card"><form class="toolbar" style="padding-top:22px" method="get"><label class="search">Поиск<input name="q" value="{{ filters.q|default('') }}" placeholder="ФИО, ID, должность"></label><label>Статус<select name="active"><option value="all" {{ filters.active|default('1') == 'all' ? 'selected' : '' }}>Все</option><option value="1" {{ filters.active|default('1') == '1' ? 'selected' : '' }}>Работают</option><option value="0" {{ filters.active|default('') == '0' ? 'selected' : '' }}>Уволены</option></select></label><button class="button" type="submit">Найти</button><a class="button ghost" href="/admin/employees">Сбросить</a></form><div class="table-scroll"><table class="data-table" id="employees-table"><thead><tr><th>ID</th><th>Сотрудник</th><th>Группа</th><th>Статус</th><th>Доступ</th><th></th></tr></thead><tbody>{% for e in employees|default([]) %}<tr><td class="numeric">{{ e.display_id|default(e.pass_code|default('%03d'|format(e.id))) }}</td><td class="person"><strong>{{ e.name|default(e.full_name|default((e.surname|default('') ~ ' ' ~ e.given_name|default('') ~ ' ' ~ e.patronymic|default(''))|trim)) }}</strong><span>{{ e.position|default('') }}</span></td><td>{{ e.group_name|default('Не назначена') }}</td><td><span class="tag {{ e.active ? 'success' : '' }}">{{ e.active ? 'Работает' : 'Уволен' }}</span></td><td><span class="small muted">{{ e.admin_role|default('NONE') == 'NONE' ? 'Нет' : e.admin_role }}</span></td><td><div class="actions"><a class="button small ghost" href="/admin/attendance?employee_id={{ e.id }}">Табель</a><a class="button small ghost" href="/admin/print?ids={{ e.id }}">Пропуск</a>{% if canEdit %}<button class="button small" data-employee-edit="{{ e|json_encode(15) }}">Изменить</button><form action="/admin/employees/rotate-passcode" method="post" data-ajax data-confirm="Сменить код пропуска? Старая карточка перестанет работать, история сохранится. Сначала отзовите действующий Wallet-пропуск."><input name="csrf" type="hidden" value="{{ csrf }}"><input name="id" type="hidden" value="{{ e.id }}"><input name="version" type="hidden" value="{{ e.version|default(1) }}"><button class="button small ghost" type="submit">Сменить код</button></form><form action="/admin/employees/deactivate" method="post" data-confirm="{{ e.active ? 'Уволить сотрудника? История сохранится.' : 'Восстановить сотрудника?' }}"><input name="csrf" type="hidden" value="{{ csrf }}"><input name="id" type="hidden" value="{{ e.id }}"><input name="active" type="hidden" value="{{ e.active ? '0' : '1' }}"><input name="version" type="hidden" value="{{ e.version|default(1) }}"><button class="button small {{ e.active ? 'danger' : 'secondary' }}">{{ e.active ? 'Уволить' : 'Восстановить' }}</button></form>{% endif %}</div></td></tr>{% else %}<tr><td colspan="6" class="empty">Сотрудники не найдены</td></tr>{% endfor %}</tbody></table></div><div class="table-footer"><span>Показано: {{ employees|default([])|length }}{% if total|default(0) %} из {{ total }}{% endif %}</span><div class="button-row">{% if pagination.previous|default(false) %}<a href="{{ pagination.previous }}" class="button small">← Назад</a>{% endif %}{% if pagination.next|default(false) %}<a href="{{ pagination.next }}" class="button small">Далее →</a>{% endif %}{% if canEdit %}<a href="/admin/import">Импорт →</a>{% endif %}</div></div></section>
{% if canEdit %}<dialog id="employee-dialog" class="dialog"><div class="dialog-header"><div><span class="eyebrow">Кадровый справочник</span><h2 data-employee-title>Новый сотрудник</h2></div><button class="icon-button" data-close-dialog>×</button></div><form action="/admin/employees/save" method="post" data-ajax><input name="csrf" type="hidden" value="{{ csrf }}"><input name="id" type="hidden"><input name="version" type="hidden"><div class="form-grid"><label>Фамилия<input name="surname" required maxlength="100"></label><label>Имя<input name="given_name" required maxlength="100"></label><label>Отчество<input name="patronymic" maxlength="100"></label><label>Должность<input name="position" maxlength="200"></label><label data-new-employee-schedule>Начальный график<select name="group_id" data-new-employee-group required>{% for g in groups|default([]) %}{% if g.active ?? true %}<option value="{{ g.id }}" {{ g.id == 1 ? 'selected' : '' }}>{{ g.name }} · {{ g.start_time|slice(0,5) }}–{{ g.end_time|slice(0,5) }}</option>{% endif %}{% endfor %}</select></label><label>Начало работы<input type="date" name="started_on"></label><label>Окончание работы<input type="date" name="ended_on"></label><label>Статус<select name="active"><option value="1">Работает</option><option value="0">Уволен</option></select></label><label>Административная роль<select name="admin_role"><option value="NONE">Нет доступа</option><option value="MODERATOR">Модератор — просмотр</option><option value="ADMIN">Администратор</option></select></label><label>Новый пароль<input type="password" name="password" autocomplete="new-password" placeholder="Пусто — не менять"></label><label>Новый PIN выдачи NFC<input type="password" name="enrollment_pin" autocomplete="new-password" placeholder="Пусто — не менять"></label></div><p class="small muted">Новый сотрудник получит сложный код VVE автоматически. Старые числовые коды сохранены. У нового сотрудника выбранный график начнёт действовать с даты начала работы. Для изменения существующего графика откройте «Графики и календарь». Изменение доступа отзывает прежние административные сессии.</p><div class="dialog-actions"><button type="button" class="button ghost" data-close-dialog>Отмена</button><button type="submit" class="button primary">Сохранить</button></div></form></dialog>{% endif %}
{% endblock %}
