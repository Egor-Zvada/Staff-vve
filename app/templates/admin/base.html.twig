{% extends 'base.html.twig' %}
{% block body_class %}admin-body{% endblock %}
{% block body %}
<div class="admin-shell"><aside class="sidebar" id="sidebar"><a class="brand admin-brand" href="/admin"><img src="/assets/logo.png" alt="СШ ВВЕ"><div><strong>Staff</strong><span>{{ settings.org_name|default('СШ ВВЕ') }}</span></div></a><span class="nav-label">Учёт и отчёты</span><nav class="side-nav">{% for path, label in {'/admin':'Обзор','/admin/attendance':'Табель и история','/admin/employees':'Сотрудники','/admin/schedules':'Графики и календарь','/admin/leaves':'Отпуска','/admin/print':'Пропуска и печать'} %}<a href="{{ path }}" data-nav="{{ path }}">{{ label }}</a>{% endfor %}{% if user.admin_role|default('') == 'ADMIN' %}<span class="nav-label">Управление</span><a href="/admin/credentials" data-nav="/admin/credentials">NFC-карты</a><a href="/admin/wallet" data-nav="/admin/wallet">Wallet-пропуска</a><a href="/admin/import" data-nav="/admin/import">Импорт сотрудников</a><a href="/admin/settings" data-nav="/admin/settings">Настройки</a><a href="/admin/status" data-nav="/admin/status">Состояние системы</a>{% endif %}<span class="nav-label">Справка</span><a href="/admin/help" data-nav="/admin/help">Помощь и инструкции</a><a href="/">Экран отметки ↗</a></nav><div class="sidebar-bottom"><span class="tag">{{ {'ADMIN':'Администратор','MODERATOR':'Модератор','NONE':'Нет доступа'}[user.admin_role|default('MODERATOR')]|default('Нет доступа') }}</span><span class="small muted">ID {{ user.display_id|default(user.pass_code|default('%03d'|format(user.id|default(0)))) }}</span><form method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="text-button" type="submit">Выйти</button></form></div></aside>
<div class="admin-main"><header class="admin-header"><button class="icon-button menu-toggle" id="menu-toggle" aria-label="Меню">☰</button><div><span class="eyebrow">{{ settings.org_name|default('СШ ВВЕ') }}</span><strong>{% block page_title %}Администрирование{% endblock %}</strong></div><div class="header-actions"><a href="/admin/help" class="icon-button" aria-label="Помощь">?</a><button class="icon-button" id="theme-toggle" aria-label="Сменить тему" title="Светлая / Тёмная тема">◐</button><span class="user-chip">{{ user.name|default(user.surname|default('Администратор')) }}</span></div></header><main class="admin-content">{% if error|default('') %}<div class="notice error" role="alert">{{ error }}</div>{% endif %}{% if message|default('') %}<div class="notice success">{{ message }}</div>{% endif %}{% block content %}{% endblock %}</main><footer class="admin-footer">Staff · Сахалинское время · UTC+11 <a href="/admin/help">Справка</a></footer></div></div>
{% endblock %}
