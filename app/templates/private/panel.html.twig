<!doctype html>
<html lang="ru" data-theme="light"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="csrf-token" content="{{ csrf }}"><meta name="robots" content="noindex,nofollow"><title>Служебные решения</title>
<link rel="stylesheet" href="/assets/app.css?v={{ asset_version }}"><link rel="stylesheet" href="/assets/private.css?v={{ asset_version }}"><script src="/assets/private.js?v={{ asset_version }}" defer></script></head>
{% set event_labels = {'arrival':'Приход','departure':'Уход','lunch_out':'Обед: уход','lunch_in':'Обед: возврат','excused_out':'Уход по уважительной причине'} %}
{% set source_labels = {'qr':'QR-код','keyboard':'Клавиатура','nfc':'NFC-карта','manual':'Ручная форма','manual_on_time':'Ручная отметка сейчас','public_manual':'Ручное изменение','admin_manual':'Исправление администратора','admin':'Администратор','owner_adjust':'Служебное изменение'} %}
{% set weekdays = {1:'Пн',2:'Вт',3:'Ср',4:'Чт',5:'Пт',6:'Сб',7:'Вс'} %}
{% set current_tab = tab|default('week') %}
<body class="private-body"><main class="private-shell" data-private-path="{{ private_path }}">
<header class="private-header"><div class="private-brand"><span class="private-mark" aria-hidden="true">S</span><div><span class="eyebrow">Доступ владельца</span><h1>Служебные решения</h1></div></div><div class="button-row"><span class="private-timezone">Сахалин · UTC+11</span><button class="icon-button" type="button" data-private-theme aria-label="Переключить светлую и тёмную тему">◐</button><form method="post" action="{{ private_path }}/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="button ghost">Выйти</button></form></div></header>
<nav class="private-tabs" aria-label="Разделы служебного экрана">
{% for key,label in {week:'Недельный табель',automation:'Автоматизации',day:'Подробности дня'} %}<a data-private-nav href="{{ private_path }}?employee_id={{ employee_id }}&amp;week={{ week.start }}&amp;date={{ date }}&amp;tab={{ key }}" {{ current_tab == key ? 'aria-current="page"' : '' }}>{{ label }}</a>{% endfor %}
</nav>
<form method="get" action="{{ private_path }}" class="card private-filter"><input type="hidden" name="tab" value="{{ current_tab }}">
<div><label for="private-employee-search">Найти сотрудника<input id="private-employee-search" type="search" placeholder="Фамилия или ID" autocomplete="off"></label><span class="small muted" data-employee-search-status></span></div>
<label>Сотрудник<select name="employee_id" id="private-employee"><option value="0">{{ current_tab == 'automation' ? 'Все сотрудники' : 'Выберите сотрудника' }}</option>{% for person in employees %}<option value="{{ person.id }}" {{ employee_id == person.id ? 'selected' : '' }}>{{ person.display_id|default('%03d'|format(person.id)) }} · {{ person.name }}{{ person.active ? '' : ' · уволен' }}</option>{% endfor %}</select></label>
{% if current_tab == 'day' %}<input type="hidden" name="week" value="{{ week.start }}"><label>Дата<input type="date" name="date" value="{{ date }}"></label>{% else %}<label>Неделя с даты<input type="date" name="week" value="{{ week.start }}"></label>{% endif %}
<button class="button primary" type="submit">Открыть</button></form>
{% if saved and current_tab != 'day' %}<p class="notice success" role="status">Изменения сохранены.</p>{% endif %}
{% for person in employees %}{% if person.id == employee_id and not person.active %}<p class="notice">Сотрудник уволен. Исторические дни доступны для корректировки; автоматизации для него не срабатывают.</p>{% endif %}{% endfor %}
{% if current_tab == 'week' %}
<section class="private-section-heading"><div><span class="eyebrow">Вся неделя на одном экране</span><h2>{{ week.start|date('d.m') }} — {{ week.end|date('d.m.Y') }}</h2><p class="muted">Поправьте времена и выберите дни для сохранения. Остальные дни сохранят свои значения.</p></div><div class="button-row">
<a class="button" data-private-nav href="{{ private_path }}?employee_id={{ employee_id }}&amp;week={{ week.previous }}&amp;tab=week">← Ранее</a><a class="button" data-private-nav href="{{ private_path }}?employee_id={{ employee_id }}&amp;week={{ today|default('now'|date('Y-m-d','Asia/Sakhalin')) }}&amp;tab=week">Текущая неделя</a><a class="button" data-private-nav href="{{ private_path }}?employee_id={{ employee_id }}&amp;week={{ week.next }}&amp;tab=week">Новее →</a></div></section>
{% if employee_id > 0 %}
<form method="post" action="{{ private_path }}/week" id="owner-week-form" class="card private-week-card" data-private-dirty>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="employee_id" value="{{ employee_id }}"><input type="hidden" name="week_start" value="{{ week.start }}"><input type="hidden" name="request_id" value="{{ week_request_id }}">
<div class="private-week-tools"><label class="check"><input type="checkbox" data-week-select-all> Выбрать доступные дни</label><div class="button-row"><button class="button small" type="button" data-week-preset>Приход и уход по графику</button><button class="button small" type="button" data-week-clear-selection>Снять выбор</button></div></div>
<p class="private-week-hint small muted">Галочка «Очистить» удалит исходные отметки, правки и признаки выбранного дня, сохранив времена из строки. Без неё меняются только времена. Будущие дни недоступны.</p>
<div class="private-table-scroll"><table class="private-week-table"><thead><tr><th class="private-select-cell"><span class="visually-hidden">Выбрать</span></th><th>День и график</th><th>Приход</th><th>Уход</th><th>Обед: ушёл</th><th>Обед: вернулся</th><th>Уваж. уход</th><th>Записи и признаки</th><th>Очистить</th><th><span class="visually-hidden">Подробнее</span></th></tr></thead><tbody>
{% for day in week.days %}{% set day_date = day.work_date|default(day.date) %}
<tr data-week-row="{{ day_date }}" data-plan-start="{{ day.plan.start_time|default('') }}" data-plan-end="{{ day.plan.end_time|default('') }}" class="{{ day_date == today|default('') ? 'is-today' : '' }} {{ day.is_future ? 'is-future' : '' }}">
<td class="private-select-cell"><input type="checkbox" name="rows[{{ day_date }}][selected]" value="1" data-week-select aria-label="Сохранить {{ day_date|date('d.m.Y') }}" {{ day.is_future ? 'disabled' : '' }}><input type="hidden" name="rows[{{ day_date }}][version]" value="{{ day.version }}"></td>
<td class="private-day-cell"><strong>{{ day_date|date('d.m') }} <span>{{ day.weekday|default(weekdays[day_date|date('N')]) }}</span></strong><span class="small muted">{{ day.on_leave ? 'Отпуск' : day.is_guard ? 'Охранник' : day.is_working ? day.group_name : 'Вне плана' }}</span>{% if day.is_future %}<span class="small muted">Будущий день</span>{% endif %}</td>
{% for field in ['arrival','departure','lunch_out','lunch_in','excused_out'] %}<td><input type="time" step="60" name="rows[{{ day_date }}][values][{{ field }}]" data-week-time="{{ field }}" aria-label="{{ event_labels[field] }} {{ day_date|date('d.m.Y') }}" value="{{ attribute(day.values,field)|default('')|slice(0,5) }}" {{ day.is_future ? 'disabled' : '' }}></td>{% endfor %}
<td class="private-day-summary"><span class="small muted">Отметки: {{ day.public_events_count|default(day.events|length) }} · правки: {{ day.changes_count|default(day.changes|length) }}</span>{% if day.active_flags|default([])|length %}<span class="tag warning">Признаков: {{ day.active_flags|length }}</span>{% else %}<span class="tag success">Без признаков</span>{% endif %}</td>
<td><label class="private-clean-check"><input type="checkbox" name="rows[{{ day_date }}][clean]" value="1" data-week-clean aria-label="Очистить записи и признаки {{ day_date|date('d.m.Y') }}" {{ day.is_future ? 'disabled' : '' }}><span class="small">Очистить</span></label></td><td><a class="text-button" data-private-nav href="{{ private_path }}?employee_id={{ employee_id }}&amp;week={{ week.start }}&amp;date={{ day_date }}&amp;tab=day" aria-label="Подробности {{ day_date|date('d.m.Y') }}">Открыть ↗</a></td></tr>
{% endfor %}</tbody></table></div>
<div class="private-save-bar"><div><strong data-week-selected-count>Дни не выбраны</strong><p id="owner-week-status" class="form-status" role="status" aria-live="polite">Изменений нет</p></div><div class="button-row"><button class="button" type="button" data-week-reload hidden>Перечитать неделю</button><button class="button primary" type="submit" data-week-save>Сохранить выбранные дни</button></div></div>
</form>
{% else %}<div class="card empty"><h2>Выберите сотрудника</h2><p>Откройте его неделю, чтобы видеть и редактировать все отметки рядом.</p></div>{% endif %}
{% elseif current_tab == 'day' %}
<div class="private-detail"><div class="private-section-heading"><div><span class="eyebrow">Подробности и выборочные действия</span><h2>{{ date|date('d.m.Y') }}</h2></div><a class="button" data-private-nav href="{{ private_path }}?employee_id={{ employee_id }}&amp;week={{ week.start }}&amp;tab=week">← К недельному табелю</a></div>{% if detail %}{% include 'private/day-detail.html.twig' %}{% else %}<div class="card empty">Выберите сотрудника, чтобы открыть подробности дня.</div>{% endif %}</div>
{% elseif current_tab == 'automation' %}
<div class="private-section-heading"><div><span class="eyebrow">Правила по сотрудникам</span><h2>Автоматические отметки</h2><p class="muted">Проверка каждую минуту. Правило заполняет только пустую метку и сохраняет существующие отметки.</p></div><button class="button primary" type="button" data-rule-new>+ Создать правило</button></div>
<div class="notice">Все часы — сахалинские. Отпуска, охранники и неактивные сотрудники пропускаются. Можно ограничить правило рабочими днями. Новое правило выключено, пока вы явно его не включите.</div>
<section class="private-heartbeat" aria-label="Состояние автоматизаций"><div class="muted">Включено правил<strong>{{ automation_status.enabled_rules|default(0) }}</strong></div><div class="muted">Последняя проверка<strong>{{ automation_status.last_finished_at|default(null) ? (automation_status.last_finished_at ~ ' UTC')|date('d.m.Y H:i:s','Asia/Sakhalin') : 'Проверок ещё не было' }}</strong></div><div class="muted">Последняя успешная проверка<strong>{{ automation_status.last_success_at|default(null) ? (automation_status.last_success_at ~ ' UTC')|date('d.m.Y H:i:s','Asia/Sakhalin') : 'Пока нет' }}</strong></div>{% if automation_status.last_error|default(null) %}<div class="form-status error">{{ automation_status.last_error }}</div>{% endif %}</section>
<div class="private-automation-layout"><section class="card private-rule-editor"><span class="eyebrow" data-rule-editor-caption>Новое правило</span><h2>Когда и что поставить</h2>
<form method="post" action="{{ private_path }}/automation/save" id="owner-automation-form" data-private-dirty>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="id" value=""><input type="hidden" name="version" value=""><input type="hidden" name="return_employee_id" value="{{ employee_id }}"><input type="hidden" name="week_start" value="{{ week.start }}">
<label>Название<input name="name" required maxlength="100" placeholder="Например, приход утром"></label><label>Сотрудник<select name="employee_id" required><option value="">Выберите сотрудника</option>{% for person in employees %}<option value="{{ person.id }}" {{ employee_id == person.id ? 'selected' : '' }}>{{ person.name }} · {{ person.display_id }}{{ person.active ? '' : ' · уволен' }}</option>{% endfor %}</select></label>
<label>Метка<select name="event_type">{% for key,label in event_labels %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label>
<div class="form-grid"><label>Проверять после<input type="time" name="trigger_time" value="10:00" required></label><label>Если пусто, поставить<input type="time" name="mark_time" value="09:00" required></label></div>
<label>День срабатывания<select name="trigger_day_offset"><option value="0">В день отметки</option><option value="1">На следующий день — за предыдущий</option></select></label>
<fieldset class="private-weekdays"><legend>Дни недели отметки</legend>{% for n,label in weekdays %}<label><input type="checkbox" name="weekdays[]" value="{{ n }}" {{ n <= 5 ? 'checked' : '' }}><span>{{ label }}</span></label>{% endfor %}</fieldset>
<input type="hidden" name="working_days_only" value="0"><label class="check"><input type="checkbox" name="working_days_only" value="1" checked> Только дни с рабочим планом</label>
<div class="form-grid"><label>Действует с<input type="date" name="valid_from" value="{{ today|default('now'|date('Y-m-d','Asia/Sakhalin')) }}" required></label><label>По дату · необязательно<input type="date" name="valid_to"></label></div>
<input type="hidden" name="enabled" value="0"><label class="check private-enable"><input type="checkbox" name="enabled" value="1"> Включить правило</label>
<p class="small muted">Пример: после 10:00 проверить приход и, если его нет, поставить 09:00. Для ухода создайте отдельное правило. При включении прошлые недели не заполняются.</p><div class="button-row"><button class="button primary" type="submit">Сохранить правило</button><button class="button ghost" type="button" data-rule-cancel>Сбросить</button></div>
</form></section>
<div class="private-rule-column"><section class="card"><div class="section-heading"><h2>Ваши правила</h2><span class="tag">{{ rules|length }}</span></div><div class="private-rule-list">
{% for rule in rules %}<article class="private-rule-card" data-rule-id="{{ rule.id }}"><div class="section-heading"><strong>{{ rule.name }}</strong><span class="tag {{ rule.enabled ? 'success' : '' }}">{{ rule.enabled ? 'Включено' : 'Выключено' }}</span></div><p>{{ rule.employee_name }} <span class="small muted">· {{ rule.display_id }}</span></p><p class="private-rule-equation"><strong>{{ rule.trigger_time|slice(0,5) }}</strong><span>→</span><span>{{ event_labels[rule.event_type]|default('Отметка') }} <strong>{{ rule.mark_time|slice(0,5) }}</strong></span></p><p class="small muted">{{ rule.trigger_day_offset ? 'На следующий день за предыдущий' : 'В день отметки' }} · {% for n in rule.weekdays %}{{ weekdays[n] }}{{ not loop.last ? ', ' : '' }}{% endfor %}<br>{{ rule.working_days_only ? 'Только рабочий план' : 'Включая дни вне плана' }} · с {{ rule.valid_from|date('d.m.Y') }}{{ rule.valid_to ? ' по ' ~ rule.valid_to|date('d.m.Y') : '' }}</p>
<div class="button-row"><button class="button small" type="button" data-rule-edit="{{ rule|json_encode(15) }}">Изменить</button><form method="post" action="{{ private_path }}/automation/toggle" data-rule-toggle><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="id" value="{{ rule.id }}"><input type="hidden" name="version" value="{{ rule.version }}"><input type="hidden" name="enabled" value="{{ rule.enabled ? '0' : '1' }}"><input type="hidden" name="return_employee_id" value="{{ employee_id }}"><input type="hidden" name="week_start" value="{{ week.start }}"><button class="button small {{ rule.enabled ? 'ghost' : 'secondary' }}" type="submit">{{ rule.enabled ? 'Выключить' : 'Включить' }}</button></form></div></article>
{% else %}<div class="empty">Правил пока нет. Создайте отдельное правило для нужной метки сотрудника.</div>{% endfor %}</div></section>
<section class="card"><h2>Последние срабатывания</h2><p class="small muted">Здесь видны автоматические действия и причины пропуска. Существующая метка не заменяется.</p><div class="private-runs">
{% for run in automation_runs %}<article><div class="section-heading"><strong>{{ run.employee_name|default(run.rule_name) }}</strong><span class="tag {{ run.status == 'applied' ? 'success' : '' }}">{{ {'applied':'Поставлено','already_present':'Метка уже есть','skipped':'Пропущено'}[run.status]|default('Проверено') }}</span></div><p class="small">{{ run.work_date|date('d.m.Y') }} · {{ event_labels[run.event_type]|default('Отметка') }} · {{ run.rule_name }}</p><p class="small muted">{{ run.message|default('') }}</p><time class="small muted">{{ (run.created_at ~ ' UTC')|date('d.m.Y H:i:s','Asia/Sakhalin') }}</time></article>{% else %}<p class="muted">Срабатываний пока нет.</p>{% endfor %}</div></section></div></div>
{% endif %}
<footer class="private-footer">Служебный экран · изменения применяются только к выбранным дням и правилам</footer>
</main></body></html>
