
{% if saved %}<p class="card" role="status">Изменения сохранены.</p>{% endif %}
<form method="post" action="{{ private_path }}/adjust" class="card" id="owner-clear-form" data-private-dirty>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="employee_id" value="{{ employee_id }}"><input type="hidden" name="work_date" value="{{ date }}"><input type="hidden" name="version" value="{{ detail.version }}"><input type="hidden" name="request_id" value="{{ clear_request_id }}"><input type="hidden" name="action" value="clear_and_correct">
<span class="eyebrow">{{ detail.full_name }} · {{ date|date('d.m.Y') }}</span><h2>Очистить день и сохранить времена</h2>
<p class="muted">Все исходные отметки, правки и признаки выбранного дня будут удалены. В табеле останутся только времена из этих полей. Пустое поле очищает значение.</p>
<div class="form-grid">{% for key,label in {'arrival':'Приход','departure':'Уход','lunch_out':'Обед: уход','lunch_in':'Обед: возврат','excused_out':'Уважительный уход'} %}<label>{{ label }}<input name="values[{{ key }}]" type="time" value="{{ attribute(detail.values,key)|default('') }}"></label>{% endfor %}</div>
<label>Примечание · необязательно<textarea name="reason" maxlength="2000"></textarea></label>
<button class="button primary" type="submit">Очистить записи и сохранить</button>
</form>
<details class="card"><summary>Выборочные действия с записями</summary>
<form method="post" action="{{ private_path }}/adjust">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="employee_id" value="{{ employee_id }}"><input type="hidden" name="work_date" value="{{ date }}"><input type="hidden" name="version" value="{{ detail.version }}"><input type="hidden" name="request_id" value="{{ advanced_request_id }}">
<p class="muted small">Для полной очистки используйте основную форму выше. Здесь можно скрыть отдельные записи, изменить отдельные поля или вернуть видимость оставшихся записей.</p>
<label>Действие<select name="action"><option value="suppress">Скрыть выбранные записи и признаки</option><option value="correct">Изменить выбранные поля</option><option value="restore">Вернуть видимость выбранных записей</option></select></label>
<label class="check"><input type="checkbox" name="all" value="1"> Все записи дня · для скрытия или возврата видимости</label>
{% for section in [{key:'flags',label:'Признаки',input:'flag_ids'},{key:'changes',label:'Изменения',input:'correction_ids'},{key:'events',label:'Исходные события',input:'event_ids'}] %}
<h3>{{ section.label }}</h3><div class="table-wrap"><table><thead><tr><th>Выбрать</th><th>ID</th><th>Подробности</th></tr></thead><tbody>{% for item in attribute(detail,section.key)|default([]) %}<tr><td><input type="checkbox" name="{{ section.input }}[]" value="{{ item.id }}" aria-label="Выбрать запись {{ item.id }}"></td><td>{{ item.id }}</td><td style="overflow-wrap:anywhere;white-space:normal">{% if section.key == 'flags' %}<strong>{{ item.label|default('Замечание') }}</strong>{% if item.details.message|default('') %}<div>{{ item.details.message }}</div>{% endif %}{% if item.details.seconds|default(0) %}<div>Отклонение: {{ (item.details.seconds / 60)|round(1) }} мин.</div>{% endif %}{% elseif section.key == 'changes' %}<strong>{{ attribute(event_labels,item.event_type)|default('Отметка') }}</strong><div>{{ item.before_at ? item.before_at|date('d.m.Y H:i','Asia/Sakhalin') : '—' }} → {{ item.after_at ? item.after_at|date('d.m.Y H:i','Asia/Sakhalin') : '—' }}</div><div>Внесено: {{ item.received_at|date('d.m.Y H:i:s','Asia/Sakhalin') }} · {{ attribute(source_labels,item.source)|default('Другой источник') }}</div>{% else %}<strong>{{ attribute(event_labels,item.event_type)|default('Отметка') }}</strong><div>{{ item.event_at|date('d.m.Y H:i:s','Asia/Sakhalin') }} · {{ attribute(source_labels,item.source)|default('Другой источник') }}</div><div>Принято сервером: {{ item.received_at|date('d.m.Y H:i:s','Asia/Sakhalin') }}</div>{% endif %}<div class="small muted">{% if item.private|default(false) %}Скрыто{% else %}Видимо{% endif %}{% if section.key == 'flags' %} · {{ item.active|default(false) and not item.suppressed|default(false) ? 'Действует' : 'Не действует' }}{% endif %}</div></td></tr>{% else %}<tr><td colspan="3">Записей нет</td></tr>{% endfor %}</tbody></table></div>
{% endfor %}
<fieldset><legend>Для изменения выберите поля</legend><div class="form-grid">{% for key,label in {'arrival':'Приход','departure':'Уход','lunch_out':'Обед: уход','lunch_in':'Обед: возврат','excused_out':'Уважительный уход'} %}<label><span><input type="checkbox" name="apply_fields[]" value="{{ key }}"> {{ label }}</span><input name="values[{{ key }}]" type="time" value="{{ attribute(detail.values,key)|default('') }}"></label>{% endfor %}</div><p class="muted small">Пустое выбранное поле очищает официальное значение. Остальные поля сохраняются.</p></fieldset>
<label>Примечание · необязательно<textarea name="reason" maxlength="2000"></textarea></label><button class="button" type="submit">Применить выборочное действие</button>
</form></details>
<section class="card"><h2>Текущее состояние дня</h2><p>{{ detail.status_label|default('Состояние не определено') }}</p><div class="inline"><span>Отметок: {{ detail.events|length }}</span><span>Изменений: {{ detail.changes|length }}</span><span>Признаков: {{ detail.flags|length }}</span></div><p class="small muted" style="margin:12px 0 0">График: {{ detail.on_leave ? 'Отпуск' : detail.is_guard ? 'Охранник · без контроля графика' : detail.group_name|default('Без графика') }}</p></section>
