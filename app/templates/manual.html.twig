{% extends 'base.html.twig' %}
{% block title %}Ручная отметка · Staff{% endblock %}
{% block body_class %}manual-body{% endblock %}
{% block body %}
<div class="manual-page"><header class="public-header"><a class="brand" href="/"><img src="/assets/logo.png" alt="СШ ВВЕ"><strong>{{ settings.org_name|default('СШ ВВЕ') }}</strong></a><a href="/" class="button ghost">← К сканированию</a></header>
<main><span class="eyebrow">Ручной ввод</span><h1>Отметка сотрудника</h1><p class="muted">Введите ID или считайте карточку в поле.</p>
<form class="card manual-lookup" method="get" action="/manual"><label>ID сотрудника<input name="code" id="manual-id" type="text" value="{{ code|default(employee.display_id|default(employee.pass_code|default(''))) }}" spellcheck="false" autocapitalize="characters" required autocomplete="off" autofocus></label><input type="hidden" name="date" value="{{ date|default('') }}"><button type="submit" class="button primary">Открыть</button></form>
{% if employee|default(null) %}
<section class="card"><div class="section-heading"><div><span class="eyebrow">ID {{ employee.display_id|default(employee.pass_code|default('%03d'|format(employee.id))) }}</span><h2>{{ employee.name|default(employee.full_name|default((employee.surname|default('') ~ ' ' ~ employee.given_name|default('') ~ ' ' ~ employee.patronymic|default(''))|trim)) }}</h2></div><span class="tag">{{ date|default('') }}</span></div>
<div class="now-actions"><p class="muted">Отметиться текущим временем сервера</p><div class="button-row"><button class="button primary" data-mark-now="arrival" data-employee-id="{{ employee.id }}" data-employee-code="{{ employee.display_id|default(employee.pass_code|default('%03d'|format(employee.id))) }}">Приход сейчас</button><button class="button secondary" data-mark-now="departure" data-employee-id="{{ employee.id }}" data-employee-code="{{ employee.display_id|default(employee.pass_code|default('%03d'|format(employee.id))) }}">Уход сейчас</button></div></div>
<hr><form id="manual-form" data-employee-id="{{ employee.id }}" data-employee-code="{{ employee.display_id|default(employee.pass_code|default('%03d'|format(employee.id))) }}" data-version="{{ day.version|default(0) }}"><div class="section-heading"><div><h3>Дата и время</h3><button type="button" id="manual-reload" class="text-button">Перечитать день</button></div><label class="compact-label">День<input name="work_date" type="date" value="{{ date|default('') }}" required id="manual-date"></label></div>
<div class="form-grid">{% for key,label in {arrival:'Приход',departure:'Уход'} %}{% set value = attribute(day.values|default({}),key)|default('') %}<label>{{ label }}<input type="time" name="{{ key }}" value="{{ value|slice(0,5) }}" data-original="{{ value|slice(0,5) }}"></label>{% endfor %}</div>
{% if settings.extra_events|default(false) %}<details class="form-details"><summary>Другие отметки</summary><div class="form-grid">{% for key,label in {lunch_out:'Обед — ушёл',lunch_in:'Обед — вернулся',excused_out:'Уход по уважительной'} %}{% set value = attribute(day.values|default({}),key)|default('') %}<label>{{ label }}<input type="time" name="{{ key }}" value="{{ value|slice(0,5) }}" data-original="{{ value|slice(0,5) }}"></label>{% endfor %}</div></details>{% endif %}
<div class="form-footer"><span id="manual-status" class="form-status" role="status">Изменений нет</span><button class="button primary" type="submit">Сохранить изменения</button></div></form></section>
{% elseif code|default('') or employee_id|default(0) %}<div class="notice error">Сотрудник не найден или недоступен для отметки.</div>{% endif %}
</main></div>
{% endblock %}
